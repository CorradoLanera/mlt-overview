.Rproj.user
.Rhistory
.RData
.Ruserdata

# Local-only Claude settings (vault paths — private; repo may go public)
.claude/settings.local.json
# Temporary workshop deck (to be deleted by the author)
docs/StorIA_2026.pptx
# Scratch
*.tmp.md
docs/_*.tmp*
# Quarto/pandoc build artifacts
/_site/
/_book/
/.quarto/
# Self-contained MLT deck output (~16 MB; rebuilt by `quarto render`)
slides/slides.html
slides/*_files/
# Per-chapter Quarto previews (rebuilt by `quarto render` on each .qmd)
slides/chapters/*.html
slides/chapters/*_files/
# Headless-browser QA screenshots used while authoring the deck
slides/qa-shots/
.qa-screenshots/
# Python
__pycache__/
.pytest_cache/
# Transient QA screenshots and scratch files in dev/ — not deliverables
# (dev/ is NOT globally ignored so that dev/mltbuild/ can be tracked)
dev/*.png
dev/*.R
dev/*.txt
dev/*.py
dev/release-assets/
# Built workshop ZIPs — published as GitHub Release assets, not committed
dist/
# Generated site partials (rebuilt by scripts/build_site.py)
site/_generated/
# mltbuild scratch (plan 1)
dev/mltbuild/**/_generated/

# Generated workshop trees (build on-demand from _authoring/ via dev/mltbuild/build.R)
workshops/*/steps/
workshops/*/full/
workshops/*/_solved/

# Transient QA/audit screenshots + runtime locks under .claude/ (scratch, not deliverables)
/.claude/*.png
/.claude/*.lock
